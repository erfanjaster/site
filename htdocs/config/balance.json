  "formulas": {
    "upgrade_cost": "base_cost * cost_growth^(level)",
    "upgrade_prod": "base_prod * level        // prod_growth = 1.00 → LINEAR; this is deliberate (see pacing_note)",
    "gps_raw": "sum(upgrade_prod) for level > 0",
    "gps": "gps_raw * prestige_mult * skill_mult * buff_mult * zone_mult",
    "prestige_mult": "1 + 0.02 * sparks",
    "click_value": "(base_click + 0.05 * gps_raw) * click_skill_mult * combo_mult * golden_mult",
    "base_click": "1 + prestige_level",
    "xp_to_next": "floor(100 * 1.35^(level-1))",
    "sparks_on_prestige": "floor(sqrt(lifetime_gold_this_run / 1e6))",
    "offline_gain": "floor(gps * min(now - last_settle, offline_cap) * offline_efficiency)",
    "battle_power": "(sum(level*tier) + 100*prestige_level) * war_doctrine_mult",
    "win_chance": "atk_power / (atk_power + def_power)"
  },
  "idle": {
    "offline_efficiency_base": 0.5,
